# Copy to .env (which git ignores) and fill in.
# Create a key at https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=

# Optional: which models `rift-rumors hello` compares (comma-separated).
# RIFT_MODELS=claude-haiku-5-5,ollama:llama3.2:3b

# Leaguepedia (lol.fandom.com) blocks anonymous data queries. Use a bot password:
#   1. Create a Fandom account and confirm your email (Special:Preferences).
#   2. On lol.fandom.com, open Special:BotPasswords, pick a bot name (e.g. riftrumors),
#      tick "Create, query and delete data through the Cargo extension", and create.
#   3. Username is "YourAccount@riftrumors"; password is the long string it shows once.
LEAGUEPEDIA_USERNAME=
LEAGUEPEDIA_BOT_PASSWORD=
